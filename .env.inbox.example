# Separate Amvera app on a DIFFERENT origin and its own /data volume.
APP_MODE=inbox
PORT=3000
DATA_DIR=/data
INBOX_ENABLED=true
INBOX_ORIGIN=https://your-private-inbox.example.com
# Generate with npm run inbox:setup. Never commit real values.
INBOX_PASSWORD_HASH=
INBOX_TOTP_SECRET=
INBOX_ENCRYPTION_KEY=

# Same random read-only token in BOTH apps; no admin password used.
INBOX_ORDERS_URL=https://your-shop.example.com/api/integrations/orders
INBOX_ORDERS_READ_TOKEN=

# Read-only IMAP; password for this application, never the primary account password.
INBOX_IMAP_HOST=imap.yandex.ru
INBOX_IMAP_USER=
INBOX_IMAP_PASSWORD=
INBOX_IMAP_FOLDER=INBOX
# Optional explicit first import date, e.g. 2026-09-01T00:00:00+09:00.
# Once connected, the date/UID checkpoint is persisted; changing this value does not reset it.
INBOX_MAIL_SINCE=
# Exact comma-separated FROM addresses copied from actual bank/order messages.
INBOX_SBER_SENDERS=
INBOX_TOCHKA_SENDERS=
INBOX_MILKU_SENDERS=
INBOX_FLEXBE_SENDERS=

# Receive-only endpoints; existing GREEN-API settings are NOT changed by this app.
INBOX_WHATSAPP_INSTANCE_ID=
INBOX_WHATSAPP_WEBHOOK_TOKEN=
INBOX_MAX_INSTANCE_ID=
INBOX_MAX_WEBHOOK_TOKEN=
INBOX_FLEXBE_WEBHOOK_TOKEN=
# Optional periodic recovery/synchronization of Flexbe leads (recommended).
INBOX_FLEXBE_API_URL=
INBOX_FLEXBE_API_KEY=
# First synchronization date; default seven days ago, then persisted.
INBOX_FLEXBE_SINCE=
